package RealTimeExample;

import java.util.List;
import java.util.stream.Collectors;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.testng.Assert;



public class RealTimeExampleForStreams {

	public static void main(String[] args) {


		
		WebDriver driver = new ChromeDriver();
		driver.get("https://rahulshettyacademy.com/seleniumPractise/#/offers");
		
		//Click on filter option and sort
		
		driver.findElement(By.xpath("//thead/tr/th[1]")).click();
		//get the elements present in 1st colomun
		List<WebElement> veggiesnames = driver.findElements(By.xpath("//tbody/tr/td[1]"));
		//get the text present in the elements
		List<String> originalList = veggiesnames.stream().map(s->s.getText()).collect(Collectors.toList());
	
		
		//Now sort the values and store in a string and compare orginal and sorted values
		
		List<String> sortedList = originalList.stream().sorted().collect(Collectors.toList());
		
		
		Assert.assertTrue(sortedList.equals(originalList));
		
		List<String> veggiePrice;
		
		
		do {

			//Now get the price of an viggie example "Rice"
			List<String> veggiePrice1 = veggiesnames.stream().filter(s->s.getText().contains("Rice"))
			.map(s->getVeggiesPrice(s)).collect(Collectors.toList());
			
			veggiePrice1.forEach(s->System.out.println(s));
			
			if(veggiePrice1.size()<1) 
			{
				driver.findElement(By.xpath("//a[@aria-label='Next']")).click();
				
			}
			
			
		}while(veggiePrice.size()<1);
			

	}
	

	private static String getVeggiesPrice(WebElement s) {
		
		String price = s.findElement(By.xpath("/following-sibling::td[1]")).getText();
		
		return price;
	}

}
